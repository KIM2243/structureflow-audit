# real: 운영, demo: 모의투자
KIWOOM_MODE=real

# 운영 REST API 앱 키
APP_KEY=
APP_SECRET=

# 모의투자 REST API 앱 키
APP_KEY_MOCK=
APP_SECRET_MOCK=

# 선택 사항: 한 요청의 제한 시간(ms), 기본값 6000
KIWOOM_TIMEOUT_MS=6000

# 집 PC 조회 전용 브리지. 최소 32자의 임의 문자열을 사용하세요.
KIWOOM_BRIDGE_HOST=127.0.0.1
KIWOOM_BRIDGE_PORT=8789
KIWOOM_BRIDGE_TOKEN=

# 배포 사이트에서만 설정합니다. 로컬 직접 연결 시 비워두세요.
KIWOOM_BRIDGE_URL=
